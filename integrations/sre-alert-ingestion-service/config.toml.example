[server]
# Total SIGTERM budget; must cover drain_delay + request_wait + allocator_drain.
# Choreo's termination grace period must be longer (30s or more).
shutdown_grace = "25s"
# After SIGTERM, /healthz answers 503 for this long before the listener closes.
drain_delay = "5s"
# How long a request waits for its ids, and how long in-flight requests get on shutdown.
request_wait = "8s"
# The allocator's own time to claim and write what is queued, even if requests overran.
allocator_drain = "7s"
read_timeout = "10s"
write_timeout = "30s"
# Keep-alive connections idle this long are closed.
idle_timeout = "60s"
# Bodies over this are answered 413 and never claim an id.
max_body_bytes = 1048576

[auth]
# Vendor-route auth hook. Only "none" exists today: the routes are public.
mode = "none"

[allocator]
# Alerts waiting to be claimed; when full, new webhooks get 503 immediately.
queue_size = 5000
# Max alerts claimed with a single compare-and-set on alert_seq.
max_batch = 200
# Parallel row writers per replica.
write_concurrency = 64
# Compare-and-set attempts per batch before its requests fail with 503.
claim_max_attempts = 20

[store]
# Insert attempts on the same id before writing a filler row.
insert_attempts = 3
# Delay before the second attempt; doubles each time (100ms, then 200ms).
insert_base_delay = "100ms"
# Per-query timeout for row inserts and read-backs.
query_timeout = "1.5s"
# Timeout for the alert_seq read and compare-and-set; longer, so a slow claim isn't mistaken
# for a failure that may leave claimed ids without rows.
claim_timeout = "5s"

[cassandra]
# Startup connection retry, so a transient blip doesn't crash-loop the pod.
connect_max_attempts = 5
connect_base_delay = "2s"
connect_timeout = "10s"

[wake]
# Timeout for the fire-and-forget POST /alert to alerts-core.
timeout = "2s"

[reject]
# One rejected-webhook Chat card per vendor + error class per window, at most 10 per replica;
# the rest are counted and reported on the next card.
window = "15m"
# How much of a rejected body the card shows.
body_preview_chars = 500

[fallback]
# DB-failure Chat cards per minute, per replica, before switching to one summary per minute.
cards_per_minute = 5

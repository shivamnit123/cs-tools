# Copy to .env and fill in real values. No quotes: docker --env-file keeps them literally.

# Cosmos DB for Apache Cassandra connection (same variables as sre-alert-core-service).
CASSANDRA_CONTACT_POINT=your-account.cassandra.cosmos.azure.com
CASSANDRA_KEYSPACE=alertintegration
CASSANDRA_KEY=your-cosmos-db-key
# Optional: defaults to the contact point's leading DNS label (Cosmos DB account name == username).
CASSANDRA_USERNAME=
# Optional: defaults to 10350.
CASSANDRA_PORT=10350

# sre-alert-core-service's POST /alert, called once per written batch to wake its poller.
# Empty skips the call (local dev); alerts-core's 10-second poll still picks the alerts up.
ALERT_CORE_WAKE_URL=

# Comma-separated Google Chat incoming-webhook URLs for rejected-webhook and DB-failure cards.
# Empty skips the cards (local dev); rejections and failures are still logged.
FALLBACK_CHAT_WEBHOOK_URLS=

# Optional per-vendor overrides, JSON, same keys and shapes as the ServiceNow Edge API alert-config properties.
AWS_ALERT_CONFIG=
AZURE_ALERT_CONFIG=
DATADOG_ALERT_CONFIG=
ELASTICSEARCH_ALERT_CONFIG=
GCP_ALERT_CONFIG=
ICINGA_ALERT_CONFIG=
OPENOBSERVE_ALERT_CONFIG=
OPENSEARCH_ALERT_CONFIG=
PROMETHEUS_ALERT_CONFIG=
SITE24X7_ALERT_CONFIG=

# Optional path to config.toml; defaults to ./config.toml. Missing file = built-in defaults.
CONFIG_PATH=

# HTTP port. Optional: defaults to 8080.
PORT=8080
